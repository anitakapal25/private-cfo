ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/artha_dev
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ENABLE_EXTERNAL_WEBHOOKS=false
ENABLE_FINANCIAL_INTEGRATIONS=false
ENABLE_BACKGROUND_SYNC=false
ENABLE_EXTERNAL_MODEL=false
ENABLE_ADVISOR_ACCESS=false
ENABLE_COMMUNITY_BENCHMARKS=false
ENABLE_WELLNESS_PROGRAMS=false
ENABLE_DATA_EXPORTS=false
ENABLE_PROACTIVE_REVIEWS=false
PROACTIVE_REVIEW_INTERVAL_SECONDS=86400
# Required before ENABLE_FINANCIAL_INTEGRATIONS may be set to true.
FINANCIAL_INTEGRATION_PROVIDER=
FINANCIAL_INTEGRATION_APPROVAL_REFERENCE=
# Transactional email is disabled by default. For Postmark, use its Server API
# Token as both SMTP_USERNAME and SMTP_PASSWORD, and keep these credentials out
# of source control.
ENABLE_PUBLIC_REGISTRATION=false
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
PUBLIC_APP_URL=http://localhost:5173
