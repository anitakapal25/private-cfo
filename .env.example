ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/artha_dev
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ENABLE_EXTERNAL_WEBHOOKS=false
ENABLE_FINANCIAL_INTEGRATIONS=false
ENABLE_BACKGROUND_SYNC=false
ENABLE_EXTERNAL_MODEL=false
EXTERNAL_MODEL_PROVIDER=openai
EXTERNAL_MODEL_APPROVAL_REFERENCE=
OPENAI_API_KEY=
ENABLE_ADVISOR_ACCESS=false
ENABLE_COMMUNITY_BENCHMARKS=false
ENABLE_WELLNESS_PROGRAMS=false
ENABLE_DATA_EXPORTS=false
ENABLE_PROACTIVE_REVIEWS=false
PROACTIVE_REVIEW_INTERVAL_SECONDS=86400
# Required before ENABLE_FINANCIAL_INTEGRATIONS may be set to true.
FINANCIAL_INTEGRATION_PROVIDER=
FINANCIAL_INTEGRATION_APPROVAL_REFERENCE=
# Brevo SMTP: copy the SMTP login and SMTP key from Settings > SMTP & API.
# SMTP_USERNAME is the provider SMTP login, not your account email.
# SMTP_PASSWORD is an SMTP key, not an API key or your account password.
# Verify EMAIL_FROM_ADDRESS in Brevo before sending. Keep credentials out of source control.
# Enable only after the public-registration release checks in the deployment runbook.
# Public registration also requires ENABLE_MFA=true and a valid ENCRYPTION_KEY.
ENABLE_PUBLIC_REGISTRATION=false
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
PUBLIC_APP_URL=http://localhost:3000

# Read-only conversational agent (release gated; rollback by disabling).
ENABLE_CONVERSATIONAL_AGENT=false
CONVERSATIONAL_MODEL=gpt-6-astra
CONVERSATIONAL_APPROVAL_REFERENCE=
CONVERSATION_MAX_ROUNDS=2
CONVERSATION_MAX_TOOLS=8
CONVERSATION_TIMEOUT_SECONDS=30
EXPLANATION_MODEL=gpt-5-mini
