ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/artha_dev
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
UPLOAD_DIR=/absolute/path/to/private/uploads
ENABLE_EXTERNAL_WEBHOOKS=false
ENABLE_FINANCIAL_INTEGRATIONS=false
ENABLE_BACKGROUND_SYNC=false
ENABLE_EXTERNAL_MODEL=false
ENABLE_ADVISOR_ACCESS=false
ENABLE_COMMUNITY_BENCHMARKS=false
ENABLE_WELLNESS_PROGRAMS=false
ENABLE_DATA_EXPORTS=false
# Required before ENABLE_FINANCIAL_INTEGRATIONS may be set to true.
FINANCIAL_INTEGRATION_PROVIDER=
FINANCIAL_INTEGRATION_APPROVAL_REFERENCE=
