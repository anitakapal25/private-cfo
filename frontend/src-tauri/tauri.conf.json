{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private CFO",
  "version": "0.1.0",
  "identifier": "in.privatecfo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Private CFO",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "msi"],
    "icon": ["icons/icon.png"],
    "category": "Finance",
    "shortDescription": "Privacy-first financial-freedom planning agent",
    "linux": {
      "deb": {
        "depends": ["bubblewrap", "clamav", "poppler-utils"]
      }
    }
  }
}
